{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "security:openssf-scorecard"],
  "flux": {
    "managerFilePatterns": [
      "/(^|/)apps/.*kustomization\\.yaml$/",
      "/(^|/)clusters/.*kustomization\\.yaml$/",
      "/(^|/)infrastructure/.*hr\\.yaml$/"
    ]
  },
  "nix": { "enabled": true },
  "packageRules": [
    {
      "groupName": "flux-helm-releases",
      "matchDepTypes": ["helm"],
      "matchManagers": ["flux"]
    },
    { "groupName": "rclone-sidecars", "matchPackageNames": ["rclone/rclone"] },
    {
      "description": "Private registry (dock.mau.dev) requires auth; bump manually.",
      "enabled": false,
      "matchPackageNames": ["/^dock\\.mau\\.dev//"]
    },
    {
      "description": "Pinned to a Postgres major (pg15); do not auto-jump majors.",
      "matchCurrentVersion": "!/^pg\\d+$/",
      "matchPackageNames": ["/^pgvector/pgvector$/"]
    }
  ],
  "postUpgradeTasks": {
    "allowedCommands": ["nix fmt"],
    "commands": ["nix fmt"],
    "executionMode": "branch",
    "fileFilters": ["**/*.nix"],
    "installTools": { "nix": {} }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "GrafanaDashboard CRs pin dashboards release tags in spec.url",
      "fileMatch": ["(^|/)grafanadashboard\\.yaml$"],
      "matchStrings": [
        "url: https://raw\\.githubusercontent\\.com/(?<registry>[^/]+/[^/]+)/(?<currentValue>v[^/]+)/"
      ],
      "datasource": "github-releases",
      "depNameTemplate": "shikanime-labs/dashboards",
      "versioningTemplate": "regex:^(?<compatibility>\\d+)\\.(?<major>\\d+)\\.(?<minor>\\d+)?$"
    }
  ]
}

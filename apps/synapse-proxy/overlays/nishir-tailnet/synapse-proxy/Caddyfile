{
	auto_https off
}

(mautrix) {
	@isMautrixWellKnown path /.well-known/matrix/mautrix
	handle @isMautrixWellKnown {
		header Content-Type application/json
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Methods "GET, OPTIONS"
		header Access-Control-Allow-Headers "Origin, Content-Type, Accept"
		header Access-Control-Max-Age "86400"
		respond `{"fi.mau.bridges":["https://matrix-discord.i.shikanime.studio","https://matrix-googlechat.i.shikanime.studio","https://matrix-linkedin.i.shikanime.studio","https://matrix-meta.i.shikanime.studio","https://matrix-signal.i.shikanime.studio","https://matrix-slack.i.shikanime.studio","https://matrix-twitter.i.shikanime.studio","https://matrix-whatsapp.i.shikanime.studio"]}` 200
	}
}

(matrix-discord-media) {
	@isDiscordDirectMediaApi path /.well-known/matrix/server /_matrix/federation/v1/media/download/* /_matrix/client/v1/media/* /_matrix/media/* /_matrix/key/* /_matrix/federation/v1/version
	handle @isDiscordDirectMediaApi {
		reverse_proxy http://mautrix-discord.shikanime.svc.cluster.local:29334
	}
}

(matrix) {
	import mautrix
	@isMatrixClient path /.well-known/matrix/* /_matrix/* /_synapse/client/*
	handle @isMatrixClient {
		reverse_proxy https://synapse.shikanime.svc.cluster.local:8448 {
			header_up Host matrix.taila659a.ts.net
			transport http {
				tls_server_name synapse
			}
		}
	}
	handle {
		respond 404
	}
}

:8008 {
	@isDiscordDirectMedia host matrix-discord-media.i.shikanime.studio
	handle @isDiscordDirectMedia {
		import matrix-discord-media
	}
	handle {
		import matrix
	}
}

